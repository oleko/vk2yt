# Скопируйте в .env и заполните своими значениями:  cp .env.example .env
# .env содержит секреты и добавлен в .gitignore — не коммитьте его.
# На сервере обязательно: chmod 600 .env

# --- VK ---
# Сервисный ключ Standalone-приложения либо ключ сообщества с правом «Видео».
VK_TOKEN=
# Числовой ID сообщества, без минуса (скрипт подставит его сам)
VK_GROUP_ID=
VK_API_VERSION=5.199
# Нужен, только если ролики закрыты приватностью и yt-dlp не берёт их анонимно.
# Экспорт cookies из браузера в формате Netscape.
VK_COOKIES_FILE=

# --- Очередь ---
# Сколько роликов обрабатывать за один прогон. 6 — предел квоты YouTube API
# (1 заливка = 1600 юнитов из 10 000 в сутки).
DAILY_LIMIT=6
# Попыток на ролик, прежде чем считать его безнадёжным
MAX_RETRIES=3
# 1 — новые ролики в начало очереди, 0 — в конец (сначала старый архив)
NEW_FIRST=0

# --- Дашборд ---
# Пароль на веб-интерфейс. Придумайте длинный случайный.
DASH_PASSWORD=
DASH_PORT=8766

# --- YouTube ---
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
# Должен совпадать с Authorized redirect URI в Google Cloud Console
YOUTUBE_REDIRECT_URI=https://your-domain.example/oauth2callback
# ID канала (UC...) — страховка: скрипт откажется работать, если авторизуетесь
# не тем аккаунтом. Можно оставить пустым.
YOUTUBE_CHANNEL_ID=

# --- RuTube ---
# 0 — не трогать RuTube вообще.
RUTUBE_ENABLED=0
RUTUBE_LOGIN=
RUTUBE_PASSWORD=
# ID канала из ссылки rutube.ru/channel/<ID>/ — нужен, если аккаунт редакторский:
# инвентарь берётся по каналу, и к нему же привязывается заливка.
RUTUBE_CHANNEL_ID=
# Список: GET https://rutube.ru/api/video/category/ (8 — «Новости и СМИ»)
RUTUBE_CATEGORY_ID=8
# Публичный URL каталога, который RuTube будет использовать, чтобы забрать файл
RUTUBE_PUBLIC_BASE_URL=https://your-domain.example/_ingest
RUTUBE_INGEST_DIR=./ingest
# Сколько ждать, пока RuTube скачает файл, прежде чем считать заливку неудачной
RUTUBE_INGEST_TIMEOUT_H=6
# Сколько ждать встроенный импорт RuTube с YouTube, прежде чем заливать напрямую
RUTUBE_IMPORT_GRACE_H=72
RUTUBE_IS_HIDDEN=0
RUTUBE_MAX_FILE_MB=2000

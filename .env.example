# Скопируйте в .env и заполните своими значениями:  cp .env.example .env
# .env содержит секреты и добавлен в .gitignore — не коммитьте его.
# На сервере обязательно: chmod 600 .env

# --- VK ---
# Сервисный ключ Standalone-приложения либо ключ сообщества с правом «Видео».
VK_TOKEN=
# Числовой ID сообщества, без минуса (скрипт подставит его сам)
VK_GROUP_ID=
VK_API_VERSION=5.199
# Нужен, только если ролики закрыты приватностью и yt-dlp не берёт их анонимно.
# Экспорт cookies из браузера в формате Netscape.
VK_COOKIES_FILE=

# --- Очередь ---
# Сколько роликов обрабатывать за один прогон. 6 — предел квоты YouTube API
# (1 заливка = 1600 юнитов из 10 000 в сутки).
DAILY_LIMIT=6
# Попыток на ролик, прежде чем считать его безнадёжным
MAX_RETRIES=3
# Обновлять список роликов из VK на каждом прогоне. Без этого новые ролики
# сообщества не попадут в очередь и пайплайн встанет, когда архив закончится.
AUTO_REFRESH_PLAN=1
# 1 — новые ролики в начало очереди (свежее уходит сразу, архив идёт следом),
# 0 — в конец (строго по порядку, от самых старых)
NEW_FIRST=1

# --- Дашборд ---
# Пароль на веб-интерфейс. Придумайте длинный случайный.
DASH_PASSWORD=
DASH_PORT=8766

# --- YouTube ---
YOUTUBE_CLIENT_SECRET=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
# Должен совпадать с Authorized redirect URI в Google Cloud Console
YOUTUBE_REDIRECT_URI=https://your-domain.example/oauth2callback
# ID канала (UC...) — страховка: скрипт откажется работать, если авторизуетесь
# не тем аккаунтом. Можно оставить пустым.
YOUTUBE_CHANNEL_ID=

# --- RuTube ---
# 0 — не трогать RuTube вообще.
RUTUBE_ENABLED=0
RUTUBE_LOGIN=
RUTUBE_PASSWORD=
# Если RuTube требует капчу/подтверждение по почте при входе — token_auth
# такое не пройдёт даже с верным паролем. Тогда возьмите токен из DevTools
# браузера (Network -> заголовок Authorization любого запроса к
# rutube.ru/api/ после обычного входа) и укажите его здесь напрямую —
# RUTUBE_LOGIN/RUTUBE_PASSWORD в этом случае не используются.
RUTUBE_TOKEN=
# ID канала из ссылки rutube.ru/channel/<ID>/. Заливать может только владелец
# канала: у редакторского доступа API отдаёт «Нет прав на заливку в канал».
RUTUBE_CHANNEL_ID=
# Суточный лимит RuTube — на практике 20 роликов. Больше, чем 6 у YouTube.
RUTUBE_DAILY_LIMIT=20
# 1 — у вас включён встроенный импорт RuTube с YouTube-канала. Тогда прямая
# заливка не обгоняет YouTube (иначе импортёр создаст на RuTube дубль) и лишь
# подбирает то, что импорт пропустил. 0 — импорт выключен, льём сами и свободно.
RUTUBE_IMPORT_ENABLED=0
# Потолок на суммарный размер ingest/, чтобы диск не распух на большой пачке
RUTUBE_INGEST_MAX_MB=4000
# Список: GET https://rutube.ru/api/video/category/ (8 — «Новости и СМИ»)
RUTUBE_CATEGORY_ID=8
# Публичный URL каталога, который RuTube будет использовать, чтобы забрать файл
RUTUBE_PUBLIC_BASE_URL=https://your-domain.example/_ingest
RUTUBE_INGEST_DIR=./ingest
# Сколько ждать, пока RuTube скачает файл, прежде чем считать заливку неудачной
RUTUBE_INGEST_TIMEOUT_H=6
# Сколько ждать встроенный импорт, прежде чем заливать напрямую.
# Работает только при RUTUBE_IMPORT_ENABLED=1.
RUTUBE_IMPORT_GRACE_H=72
RUTUBE_IS_HIDDEN=0
RUTUBE_MAX_FILE_MB=2000

# --- Описания ---
# Название телекомпании/сообщества для блока фактов в описании
DESC_CHANNEL_NAME=
# Хештеги, добавляемые в конец описания
DESC_HASHTAGS=
# Свой шаблон описания (необязательно; плейсхолдеры {text} {date} {vk_url}
# {title} {channel} {hashtags}). Если файла нет — используется встроенный.
DESC_TEMPLATE_FILE=description_template.txt
# Заменять автозаглушки VK («Video by …», «Live: …») текстом из поста
FIX_PLACEHOLDER_TITLES=1
# Сколько роликов обновлять за один --update-meta. На YouTube обновление стоит
# 51 юнит из 10 000 суточных, а 6 заливок съедают 9 600 — считайте бюджет.
META_UPDATE_LIMIT=20
